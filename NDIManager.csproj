<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>MAN_icon.ico</ApplicationIcon>

    <!-- Version Information -->
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <Company>NDI Manager</Company>
    <Product>NDI Manager</Product>
    <Description>NDI Discovery and Control Manager with Web UI</Description>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>

  <!-- Exclude folders that should not be part of the build -->
  <ItemGroup>
    <Compile Remove="NDI 6 SDK\**" />
    <Content Remove="NDI 6 SDK\**" />
    <None Remove="NDI 6 SDK\**" />

    <Content Remove="ndi-web-ui\**" />
    <None Remove="ndi-web-ui\**" />

    <Content Remove="publish\**" />
    <None Remove="publish\**" />

    <Content Remove="Output\**" />
    <None Remove="Output\**" />

    <Content Remove="DOCS\**" />
    <Content Remove="Licenses\**" />
    <Content Remove="ThirdPartyLicenses\**" />
  </ItemGroup>

  <!-- NDI runtime DLL from the installed NDI 6 SDK (override with -p:NdiSdkDir=... or the NDI_SDK_DIR env var).
       Optional at build time so CI can compile without the SDK; required to run and to publish. -->
  <PropertyGroup>
    <NdiSdkDir Condition="'$(NdiSdkDir)' == '' and '$(NDI_SDK_DIR)' != ''">$(NDI_SDK_DIR)</NdiSdkDir>
    <NdiSdkDir Condition="'$(NdiSdkDir)' == ''">C:\Program Files\NDI\NDI 6 SDK</NdiSdkDir>
    <NdiRuntimeDll>$(NdiSdkDir)\Bin\x64\Processing.NDI.Lib.x64.dll</NdiRuntimeDll>
  </PropertyGroup>

  <!-- Copy NDI DLL to build output -->
  <ItemGroup Condition="Exists('$(NdiRuntimeDll)')">
    <None Include="$(NdiRuntimeDll)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Processing.NDI.Lib.x64.dll</Link>
    </None>
  </ItemGroup>

  <Target Name="WarnMissingNdiRuntime" BeforeTargets="Build" Condition="!Exists('$(NdiRuntimeDll)')">
    <Warning Code="NDIMGR001" Text="NDI runtime not found at '$(NdiRuntimeDll)'. The app builds but will not run without Processing.NDI.Lib.x64.dll (install the NDI 6 SDK or set NdiSdkDir)." />
  </Target>

  <!-- Ensure NDI DLL is also in publish output (a release without it would not start) -->
  <Target Name="CopyNdiDllToPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(NdiRuntimeDll)')" Text="NDI runtime not found at '$(NdiRuntimeDll)'; cannot publish without it." />
    <Copy SourceFiles="$(NdiRuntimeDll)" DestinationFolder="$(PublishDir)" />
  </Target>

  <!-- Ensure wwwroot is copied to output directory -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="MAN_icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
