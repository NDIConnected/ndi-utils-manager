[Unit]
Description=NDI Manager (NDI discovery and routing, Web UI)
Documentation=https://github.com/NDIConnected/ndi-utils-manager
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=ndi-manager
Group=ndi-manager
ExecStart=/opt/ndi-manager/ndi-manager --service
# Settings (settings.json: web port) and logs live here.
Environment=NDIMANAGER_DATA_DIR=/var/lib/ndi-manager
# NDI reads its configuration (Discovery Server, groups) from $HOME/.ndi/ndi-config.v1.json.
Environment=HOME=/var/lib/ndi-manager
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Uncomment to change the web port without editing settings.json:
#Environment=NDIMANAGER_PORT=5000
StateDirectory=ndi-manager
WorkingDirectory=/var/lib/ndi-manager
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
