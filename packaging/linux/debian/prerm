#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl stop ndi-manager.service >/dev/null 2>&1 || true
        systemctl disable ndi-manager.service >/dev/null 2>&1 || true
    fi
fi

exit 0
