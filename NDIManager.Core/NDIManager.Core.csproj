<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Cross-platform core: web host, REST/SignalR API, NDI discovery and the NDI P/Invoke wrapper.
       Shared by the Windows tray app (NDIManager.csproj) and the Linux app (NDIManager.Linux). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NDIManager</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The web content (wwwroot) is served by the executables, not by this library. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

    <Version>3.3.0</Version>
    <AssemblyVersion>3.3.0.0</AssemblyVersion>
    <FileVersion>3.3.0.0</FileVersion>
    <Company>NDI Manager</Company>
    <Product>NDI Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
